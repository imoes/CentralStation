# Kopiere diese Datei nach .env und fülle die Werte aus
# .env wird NICHT ins Git eingecheckt

# PostgreSQL
POSTGRES_PASSWORD=changeme_strong_password

# Redis
REDIS_PASSWORD=changeme_redis_password

# JWT Signing Key (openssl rand -hex 32)
SECRET_KEY=changeme_jwt_secret_key_min_32_chars

# Fernet Encryption Key für Connector-Credentials
# Generieren: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=changeme_fernet_key

# OpenSearch Feed-Storage (min. 8 Zeichen, 1 Großbuchstabe, 1 Zahl)
OPENSEARCH_PASSWORD=changeme_OpenSearch1

# AWX (nur wenn docker-compose.awx.yml verwendet wird)
# docker compose -f docker-compose.yml -f docker-compose.awx.yml up -d
AWX_DB_PASSWORD=changeme_awxdb
AWX_ADMIN_PASSWORD=changeme_awxadmin
AWX_SECRET_KEY=changeme_awxsecretkey_min32chars_xyz

# Comma-separated internal DNS suffixes used for hostname detection
# (alert text, e-mail digest, topology). Leave empty for generic defaults.
CS_INTERNAL_DOMAINS=internal,local

# ── Prüf-Container (probe-runner): Manpages, Prüfschritte ────────────────────
# Gemeinsames Geheimnis Backend ↔ Runner (z. B. python3 -c 'import secrets;print(secrets.token_hex(32))')
PROBE_SHARED_SECRET=
# Den SSH-Account des Runners stellt der Administrator in der Oberfläche ein
# (Admin → KI → Prüf-Container), nicht hier.
# Zusätzliche Hosts außerhalb des CheckMK-Inventars, die geprüft werden dürfen (Komma-Liste).
CS_PROBE_EXTRA_HOSTS=
# Ziele, die nie per SSH angesprochen werden (z. B. der Docker-Host selbst), Komma-Liste.
CS_SSH_DENIED_HOSTS=
# Getrennter Agent-Nutzer + SSH-Schleuse für diese Nutzer-IDs (Komma-Liste, "*" = alle).
CS_AGENT_SPLIT_USERS=
